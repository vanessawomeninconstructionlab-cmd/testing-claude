# ---------------------------------------------------------------------------
# CoolAir HVAC Booking — environment configuration
# Copy this file to ".env" and fill in your values. All values are OPTIONAL.
# With no .env at all, the app runs in DEMO MODE (payments are simulated),
# so you can try the full booking flow without any external accounts.
# ---------------------------------------------------------------------------

# Port the web server listens on.
PORT=3000

# --- Stripe (optional) ------------------------------------------------------
# Provide a secret key to take REAL card payments via Stripe Checkout.
# Leave blank to run in demo mode (a simulated payment screen is used instead).
# Get keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# Publishable key is not required for Checkout redirect, but kept for reference.
STRIPE_PUBLISHABLE_KEY=

# Public base URL used to build Stripe success/cancel redirect links.
# In production set this to your real domain, e.g. https://booking.coolair.com
PUBLIC_BASE_URL=http://localhost:3000

# --- Admin (optional) -------------------------------------------------------
# Token required to view the admin dashboard at /admin.
# If left blank, a default of "admin" is used (change this for production!).
ADMIN_TOKEN=admin
